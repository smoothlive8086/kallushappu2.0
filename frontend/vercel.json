{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/uploads/(.*)",
      "destination": "http://44.199.251.36:25567/uploads/$1"
    },
    {
      "source": "/api/(.*)",
      "destination": "http://44.199.251.36:25567/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "http://44.199.251.36:25567/index.html"
    }
  ]
}
